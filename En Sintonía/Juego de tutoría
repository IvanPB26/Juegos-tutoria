  <title>En Sintonía | Juego de tutoría</title>
  <style>
    :root{--ink:#202b39;--muted:#647181;--paper:#f5f7f2;--white:#fff;--line:#dce2e6;--blue:#2787a8;--rose:#df5870;--green:#43984f;--yellow:#eebc00;--orange:#e47e1c;--violet:#8d4ba8;--navy:#1f3154;--shadow:0 12px 32px #26354412}
    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.45}button,input{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible{outline:3px solid #298aad66;outline-offset:2px}.shell{max-width:1440px;margin:auto;padding:20px clamp(14px,3vw,38px) 44px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}.brand{display:flex;align-items:center;gap:12px}.brand-mark{width:42px;height:42px;border-radius:12px;background:var(--navy);color:white;display:grid;place-items:center;font-weight:850;font-size:19px}.brand-name{font-weight:800;font-size:18px;line-height:1.15}.brand-sub{font-size:12px;color:var(--muted);margin-top:4px}.quiet{border:1px solid var(--line);background:#fff;color:var(--ink);padding:9px 12px;border-radius:8px;font-weight:650}.quiet:hover{background:#eef3f5}.screen{display:none}.screen.active{display:block}.intro{max-width:760px;margin:7vh auto 0;text-align:center}.eyebrow{color:#287d70;text-transform:uppercase;font-size:12px;font-weight:800}.intro h1{font-size:clamp(36px,6vw,64px);line-height:1.02;margin:12px 0 14px}.intro p{max-width:620px;margin:0 auto;color:var(--muted);font-size:17px}.setup{margin:30px auto 0;max-width:600px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:24px;text-align:left;box-shadow:var(--shadow)}.field-label{display:block;font-size:13px;font-weight:750;margin-bottom:8px}.count-select{display:flex;gap:8px;margin:0 0 18px}.count-select button{flex:1;padding:10px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink);font-weight:750}.count-select button.selected{background:var(--navy);border-color:var(--navy);color:#fff}.name-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}.name-fields input{min-width:0;width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:7px;background:#fff}.primary{border:0;border-radius:8px;padding:12px 18px;background:var(--navy);color:#fff;font-weight:800}.primary:hover{background:#2c4777}.primary:disabled{opacity:.45;cursor:not-allowed}.setup .primary{width:100%}.fineprint{font-size:12px;color:var(--muted);text-align:center;margin:12px 0 0}.rules{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin:22px auto 0;color:#495665;font-size:13px}.rules span:before{content:"✓";color:#287d70;font-weight:900;margin-right:6px}
    .game-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin:8px 0 16px}.game-head h1{font-size:28px;margin:0}.game-head p{margin:4px 0 0;color:var(--muted);font-size:14px}.game-actions{display:flex;gap:8px}.game-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.85fr);gap:18px;align-items:start}.board-panel,.side-panel{background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow)}.board-panel{padding:14px}.board-top{display:flex;align-items:center;justify-content:space-between;margin:0 2px 12px}.board-top strong{font-size:14px}.board-legend{display:flex;gap:9px;flex-wrap:wrap;color:var(--muted);font-size:10px}.legend-item{display:inline-flex;align-items:center;gap:4px}.dot{width:9px;height:9px;border-radius:3px;display:inline-block}.board{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:3px;aspect-ratio:1/1;background:#e4e9e8;padding:3px;border-radius:7px}.tile{position:relative;min-width:0;border-radius:3px;color:#fff;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden}.tile.empty{background:#f1f4f1;color:#97a2a5}.tile .tile-index{position:absolute;top:2px;left:3px;font-size:clamp(7px,.8vw,10px);opacity:.85;font-weight:700}.tile .tile-cat{font-size:clamp(6px,.8vw,10px);font-weight:750;line-height:1.08;padding:3px;overflow-wrap:anywhere}.tile.start,.tile.finish{background:var(--navy)!important}.tile.start .tile-cat,.tile.finish .tile-cat{font-size:clamp(7px,.9vw,11px);text-transform:uppercase}.tile.finish:after{content:"✦";position:absolute;font-size:11px;right:4px;top:1px;color:#fff}.token-row{position:absolute;left:2px;right:2px;bottom:2px;display:flex;justify-content:center;gap:2px}.token{width:clamp(13px,1.6vw,20px);height:clamp(13px,1.6vw,20px);border:1.5px solid #fff;border-radius:50%;display:grid;place-items:center;color:#172435;font-size:clamp(8px,.9vw,11px);font-weight:900;box-shadow:0 1px 3px #0004}.players{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}.player{border:1px solid var(--line);border-radius:7px;padding:8px 10px;display:flex;align-items:center;gap:8px;min-width:0}.player.active{border-color:var(--navy);box-shadow:0 0 0 2px #1f315418}.player .badge{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-weight:900;font-size:11px;color:#19283c;flex:none}.player .p-info{min-width:0;flex:1}.player .p-name{font-size:12px;font-weight:750;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.player .p-pos{font-size:10px;color:var(--muted)}.wedges{display:flex;gap:2px}.wedge{width:8px;height:8px;border-radius:2px;opacity:.24}.wedge.earned{opacity:1}.side-panel{padding:18px;position:sticky;top:12px}.turn-label{font-size:12px;color:var(--muted);font-weight:700;text-transform:uppercase}.turn-name{display:flex;align-items:center;gap:9px;font-size:20px;font-weight:850;margin-top:4px}.turn-name .badge{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-size:12px;color:#19283c}.turn-instruction{color:var(--muted);font-size:13px;margin:10px 0 14px}.die-wrap{background:#f5f7f2;border:1px solid var(--line);border-radius:8px;padding:14px;display:flex;align-items:center;gap:13px;margin-bottom:12px}.die{width:54px;height:54px;background:#fff;border:1px solid #d8dee2;border-radius:12px;display:grid;place-items:center;font-size:30px;font-weight:800;box-shadow:0 3px 0 #d8dee2;flex:none}.die-text strong{display:block;font-size:13px}.die-text span{font-size:12px;color:var(--muted)}.roll{width:100%;padding:13px}.card{margin-top:13px;border:1px solid var(--line);border-left:5px solid var(--blue);border-radius:8px;padding:15px;background:#fff}.card-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:9px}.category-tag{font-size:11px;font-weight:850;color:#324257}.type-tag{font-size:10px;color:#536172;background:#f0f3f3;border-radius:99px;padding:4px 7px;font-weight:750}.question{font-size:16px;font-weight:700;line-height:1.42;margin:0 0 13px}.answers{display:grid;gap:7px}.answer{width:100%;text-align:left;padding:10px 11px;background:#fff;border:1px solid var(--line);border-radius:7px;color:var(--ink);font-size:13px}.answer:hover:not(:disabled){border-color:#778999;background:#f8faf9}.answer.correct{border-color:#438a5a;background:#edf7ef}.answer.wrong{border-color:#cf5b62;background:#fff0f0}.answer:disabled{cursor:default}.feedback{font-size:13px;font-weight:750;margin:11px 0 0}.feedback.good{color:#267248}.feedback.bad{color:#a03a40}.subjective{font-size:13px;color:#596778;margin:4px 0 12px}.complete{width:100%;background:#287d70}.complete:hover{background:#20685e}.finish-card{background:#f7f8f5;border:1px solid var(--line);border-radius:8px;padding:16px;text-align:center}.finish-card .big-die{font-size:40px}.finish-card h2{margin:5px 0;font-size:18px}.finish-card p{font-size:13px;color:var(--muted)}.winner{border:1px solid #e2c75e;background:#fff9d9;border-radius:9px;padding:18px;text-align:center;margin:12px 0}.winner h2{margin:5px}.winner p{font-size:13px;color:#56606a}.modal-backdrop{position:fixed;inset:0;background:#14203177;display:none;align-items:center;justify-content:center;padding:18px;z-index:5}.modal-backdrop.open{display:flex}.modal{max-width:420px;width:100%;background:#fff;border-radius:10px;padding:22px;box-shadow:0 20px 70px #0004}.modal h2{margin:0 0 9px;font-size:21px}.modal p{color:var(--muted);font-size:14px}.modal-actions{display:flex;gap:9px;margin-top:18px}.modal-actions button{flex:1}.hidden{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:850px){.game-layout{grid-template-columns:1fr}.side-panel{position:static}.board-panel{max-width:680px;margin:auto;width:100%}.game-head{align-items:flex-start}}@media(max-width:560px){.shell{padding:12px 10px 28px}.topbar{margin-bottom:17px}.game-head{display:block}.game-actions{margin-top:10px}.board-panel{padding:8px}.board{gap:2px;padding:2px}.board-top{display:block}.board-legend{margin-top:7px;gap:5px 8px}.players{gap:5px}.player{padding:6px}.name-fields{grid-template-columns:1fr}.intro{margin-top:4vh}.setup{padding:17px}}
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="brand"><div class="brand-mark">ES</div><div><div class="brand-name">En Sintonía</div><div class="brand-sub">Un juego para conocernos mejor</div></div></div>
      <button class="quiet hidden" id="resetBtn" type="button">Nueva partida</button>
    </header>
    <section class="screen active" id="startScreen">
      <div class="intro">
        <div class="eyebrow">Bienestar · convivencia · autoconocimiento</div>
        <h1>¿Estamos en sintonía?</h1>
        <p>Un juego para conversar, poner ideas en común y descubrir cómo pensamos. Un Chromebook por grupo; los turnos se juegan entre todos.</p>
        <div class="setup">
          <label class="field-label">¿Cuántos jugadores sois?</label>
          <div class="count-select" id="playerCount"><button type="button" data-count="2">2</button><button type="button" data-count="3">3</button><button type="button" data-count="4" class="selected">4</button></div>
          <label class="field-label" for="name1">Nombres del grupo</label>
          <div class="name-fields" id="nameFields"></div>
          <button class="primary" type="button" id="startBtn">Empezar partida</button>
          <p class="fineprint">La partida se guarda automáticamente en este Chromebook.</p>
        </div>
        <div class="rules"><span>Consigue las 6 categorías</span><span>Llega a la casilla final</span><span>Gana quien lo logre primero</span></div>
      </div>
    </section>
    <section class="screen" id="gameScreen">
      <div class="game-head"><div><h1>En Sintonía</h1><p>Turnos en grupo · debatid y decidid en voz alta</p></div><div class="game-actions"><button class="quiet" id="rulesBtn" type="button">Reglas</button></div></div>
      <div class="game-layout">
        <section class="board-panel" aria-label="Tablero de juego">
          <div class="board-top"><strong>Tablero</strong><div class="board-legend" id="legend"></div></div>
          <div class="board" id="board" aria-label="Recorrido en espiral"></div>
          <div class="players" id="players"></div>
        </section>
        <aside class="side-panel" id="turnPanel" aria-live="polite"></aside>
      </div>
    </section>
  </main>
  <div class="modal-backdrop" id="modal"><div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><h2 id="modalTitle">Reglas rápidas</h2><div id="modalText"></div><div class="modal-actions"><button class="primary" id="modalClose" type="button">Volver a la partida</button></div></div></div>
  <script>
  const LS={get:k=>{try{return localStorage.getItem(k)}catch{return null}},set:(k,v)=>{try{localStorage.setItem(k,v)}catch{}},del:k=>{try{localStorage.removeItem(k)}catch{}}};
  const cats=[
    {id:"auto",name:"Autoconocimiento",color:"#2787a8",cards:[
      ["VF","Todo el mundo tiene tanto fortalezas como debilidades.","Verdadero"],["REF","Nombra algo que hoy sabes hacer que hace un año no sabías."],["TEST","¿Cuál de estas frases refleja mejor el autoconocimiento?",["Saber lo que opinan los demás de ti","Saber reconocer tus emociones, gustos y valores","Sacar siempre buenas notas"],"B"],["REF","Describe una cualidad tuya de la que te sientas orgulloso/a."],["VF","Tener defectos significa que algo va mal en ti.","Falso"],["DILEMA","Descubres que se te da genial algo que nunca imaginaste (p. ej. hablar en público). ¿Cómo reaccionarías?"],["REF","¿Qué actividad te hace perder la noción del tiempo?"],["TEST","¿Qué es la 'autoestima'?",["Pensar que eres mejor que los demás","El valor que te das a ti mismo/a","No tener nunca dudas"],"B"],["REF","Nombra una situación reciente en la que te sentiste orgulloso/a de ti mismo/a."],["VF","Compararte constantemente con los demás en redes sociales ayuda a conocerte mejor.","Falso"],["ROL","Preséntate a un desconocido en 30 segundos, contando algo real de ti (no solo tu nombre y edad)."],["DILEMA","Un amigo te dice que has cambiado mucho este año. ¿Lo ves como algo positivo o negativo? ¿Por qué?"],["REF","¿Qué es algo que te cuesta aceptar de ti mismo/a?"],["TEST","¿Cuál de estas opciones ayuda más a conocerte a ti mismo/a?",["Evitar pensar en tus errores","Reflexionar sobre lo que sientes y por qué","Hacer lo que hace la mayoría"],"B"],["REF","Si pudieras darte un consejo a ti mismo/a de hace 2 años, ¿cuál sería?"],["VF","Los intereses y gustos de una persona pueden cambiar con el tiempo, y eso es normal.","Verdadero"],["DILEMA","¿Prefieres que te digan la verdad aunque duela, o que te protejan de algo difícil? ¿Por qué?"]]},
    {id:"emocion",name:"Gestión emocional",color:"#df5870",cards:[
      ["TEST","¿Cuál de estas NO es una forma sana de gestionar el enfado?",["Respirar hondo","Gritar a quien tengas cerca","Salir a caminar"],"B"],["DILEMA","Estás muy nervioso/a antes de un examen importante. ¿Qué harías para calmarte?"],["VF","Sentir tristeza, rabia o miedo es señal de debilidad.","Falso"],["REF","¿Qué haces normalmente cuando estás muy enfadado/a? ¿Te funciona bien?"],["TEST","¿Qué significa 'regular una emoción'?",["Dejar de sentirla","Ignorarla hasta que pase","Reconocerla y manejarla sin que te controle"],"C"],["ROL","Representa cómo pedirías un momento a solas cuando estás muy enfadado/a, sin ser brusco."],["VF","Todas las emociones, incluso las desagradables, cumplen una función útil.","Verdadero"],["DILEMA","Un examen te sale mal y sientes mucha frustración. ¿Qué pensamientos te ayudarían más?"],["REF","Nombra una técnica (respiración, pausa, hablar con alguien...) que podrías usar la próxima vez que te sientas desbordado/a."],["TEST","¿Cuál de estos síntomas puede indicar que alguien está muy estresado?",["Dormir mal y estar irritable","Sentirse tranquilo","Tener más energía de lo normal"],"A"],["DILEMA","Ves que un compañero está llorando en el pasillo. ¿Qué harías?"],["VF","'Aguantarse' las emociones sin hablar de ellas es siempre la mejor opción.","Falso"],["REF","¿Con quién sueles hablar cuando algo te preocupa? ¿Te ayuda hacerlo?"],["TEST","¿Qué es la ansiedad?",["Una enfermedad que solo tienen algunos","Una respuesta natural del cuerpo ante la sensación de amenaza o presión","Lo mismo que la pereza"],"B"],["ROL","Representa cómo consolarías a un amigo/a que acaba de recibir una mala noticia."],["REF","¿Qué te ayuda a relajarte cuando tienes muchas cosas en la cabeza?"],["DILEMA","Sientes envidia porque a un amigo le va muy bien en algo que tú también quieres conseguir. ¿Qué harías con ese sentimiento?"]]},
    {id:"relaciones",name:"Relaciones y convivencia",color:"#43984f",cards:[
      ["DILEMA","Un amigo te cuenta un secreto que podría hacer daño a otra persona. ¿Qué haces?"],["VF","La empatía significa estar siempre de acuerdo con el otro.","Falso"],["TEST","¿Qué es la empatía?",["Sentir pena por alguien","Ponerte en el lugar del otro y entender cómo se siente","Ayudar a todo el mundo siempre"],"B"],["DILEMA","Ves que se ríen de un compañero en un grupo de chat. ¿Qué haces?"],["REF","Piensa en alguien que te haya escuchado bien alguna vez. ¿Qué hizo que te hiciera sentir escuchado/a?"],["VF","El respeto solo hay que mostrarlo con las personas que te caen bien.","Falso"],["ROL","Representa cómo dirías a un amigo que algo que dijo te sentó mal, sin atacarle."],["TEST","Ante un conflicto con un amigo, ¿qué suele funcionar mejor?",["Ignorarlo hasta que se olvide","Hablarlo con calma cuando ambos estéis tranquilos","Contárselo a todo el grupo"],"B"],["DILEMA","Un compañero de clase siempre come solo. ¿Qué harías?"],["REF","¿Qué cualidad valoras más en una amistad?"],["VF","Poner límites a los demás (decir 'no') es una falta de respeto.","Falso"],["DILEMA","Tus amigos hablan mal de alguien que no está presente. ¿Cómo actúas?"],["TEST","¿Cuál es una señal de una relación sana?",["Uno decide siempre por el otro","Hay confianza y respeto mutuo","Se controla lo que hace el otro"],"B"],["ROL","Representa cómo incluirías a alguien nuevo en un grupo durante el recreo."],["REF","¿Alguna vez has tenido que disculparte con alguien? ¿Cómo te sentiste al hacerlo?"],["VF","Ceder siempre en un conflicto para evitar problemas es la mejor forma de llevarse bien.","Falso"],["DILEMA","Ves un caso de acoso hacia un compañero, pero te da miedo intervenir directamente. ¿Qué otras opciones tienes?"],["TEST","¿Qué significa 'asertividad'?",["Imponer siempre tu opinión","Expresar lo que piensas y sientes respetando a los demás","Evitar decir lo que piensas"],"B"]]},
    {id:"bienestar",name:"Bienestar y hábitos saludables",color:"#eebc00",cards:[
      ["TEST","¿Cuántas horas de sueño se recomiendan aprox. a los 14-17 años?",["5-6 horas","8-10 horas","12 horas"],"B"],["REF","Nombra una actividad que te haga sentir bien y que no dependa del móvil."],["VF","Mirar el móvil justo antes de dormir ayuda a conciliar el sueño.","Falso"],["DILEMA","Tienes exámenes y te das cuenta de que llevas días durmiendo poco. ¿Qué cambiarías?"],["TEST","¿Cuál de estas es señal de uso poco saludable del móvil/redes?",["Usarlo un rato al día para hablar con amigos","Sentir ansiedad si no puedes mirarlo","Usarlo para buscar información"],"B"],["REF","¿Qué haces normalmente para desconectar y descansar la mente?"],["VF","El ejercicio físico solo sirve para estar en forma, no influye en el estado de ánimo.","Falso"],["DILEMA","Un amigo te dice que casi no duerme porque se queda jugando o en redes hasta tarde. ¿Qué le dirías?"],["TEST","¿Qué efecto tiene el ejercicio regular sobre el estado de ánimo?",["Ninguno","Puede ayudar a reducir el estrés y mejorar el ánimo","Solo cansa"],"B"],["REF","¿Cómo describirías tu relación con el móvil: equilibrada, mejorable o preocupante? ¿Por qué?"],["VF","Saltarse comidas ayuda a rendir mejor en clase.","Falso"],["DILEMA","Notas que comparar tu cuerpo o tu vida con lo que ves en redes sociales te hace sentir mal. ¿Qué podrías hacer?"],["TEST","¿Cuál de estos hábitos favorece más el bienestar general?",["Rutinas irregulares de sueño","Combinar estudio, descanso, ejercicio y tiempo social","Estar conectado todo el día"],"B"],["REF","¿Qué tres cosas te hacen sentir con energía y bienestar?"],["VF","Hablar de cómo te sientes con alguien de confianza es también un hábito saludable.","Verdadero"],["DILEMA","Tienes mucho trabajo acumulado y sientes que no llegas a todo. ¿Qué harías primero?"],["TEST","¿Qué es el 'autocuidado'?",["Hacer solo lo que apetece sin pensar en nada más","Cuidar tu cuerpo y tu mente de forma consciente","No pedir ayuda nunca"],"B"]]},
    {id:"valores",name:"Valores y actitud",color:"#e47e1c",cards:[
      ["DILEMA","Copias en un examen y nadie se entera. ¿Cómo te sientes al respecto?"],["VF","Ser responsable significa no cometer nunca errores.","Falso"],["TEST","¿Qué es la resiliencia?",["No sentir nunca tristeza","La capacidad de adaptarte y seguir adelante ante las dificultades","Ser el mejor en todo"],"B"],["REF","Cuenta una vez en la que algo te salió mal, pero aprendiste algo de ello."],["VF","Pedir perdón es una muestra de debilidad.","Falso"],["DILEMA","Encuentras una cartera con dinero en el instituto. ¿Qué haces?"],["TEST","¿Cuál de estas actitudes ayuda más a superar un fracaso?",["Pensar que nunca vas a mejorar","Analizar qué pasó y qué puedes hacer diferente","Culpar siempre a los demás"],"B"],["REF","¿Qué valor (honestidad, respeto, esfuerzo...) es más importante para ti? ¿Por qué?"],["DILEMA","Un profesor te pone una nota que consideras injusta. ¿Cómo lo gestionas?"],["VF","Tener una 'buena actitud' significa estar siempre feliz.","Falso"],["ROL","Representa cómo reconocerías un error tuyo delante de otras personas."],["TEST","¿Qué significa tener 'sentido de la responsabilidad'?",["Hacer solo lo que te obligan","Cumplir con lo que te corresponde aunque nadie te vigile","Depender siempre de otros"],"B"],["REF","¿Qué harías si vieras a alguien haciendo trampa y te pidiera que no dijeras nada?"],["VF","El esfuerzo constante suele dar mejores resultados a largo plazo que la suerte puntual.","Verdadero"],["DILEMA","Tienes la oportunidad de hacer algo que te beneficia, pero perjudica a otra persona. ¿Qué harías?"],["TEST","¿Cuál de estas actitudes refleja mejor la humildad?",["Reconocer que también puedes equivocarte y aprender","No opinar nunca","Pensar que siempre tienes razón"],"A"],["REF","¿Qué persona admiras por su actitud ante la vida? ¿Qué es lo que más valoras de ella?"]]},
    {id:"decisiones",name:"Toma de decisiones",color:"#8d4ba8",cards:[
      ["DILEMA","Tus amigos quieren hacer algo que no te convence del todo. ¿Cómo lo manejas?"],["TEST","¿Qué es la 'presión de grupo'?",["Cuando el grupo te ayuda a decidir mejor","La influencia para hacer algo con lo que no estás de acuerdo, por encajar","Un tipo de deporte"],"B"],["VF","Decir 'no' a algo que no quieres hacer puede fortalecer una amistad a largo plazo.","Verdadero"],["DILEMA","Te ofrecen probar algo (alcohol, vapear, etc.) en una fiesta y no te apetece. ¿Qué harías?"],["REF","Cuenta una decisión difícil que hayas tomado recientemente. ¿Cómo la tomaste?"],["TEST","Antes de tomar una decisión importante, ¿qué es útil hacer?",["Decidir rápido sin pensar","Valorar las consecuencias a corto y largo plazo","Copiar lo que hacen los demás"],"B"],["VF","Todas las decisiones que tomamos afectan solo a nosotros mismos, nunca a los demás.","Falso"],["DILEMA","Un amigo te pide que le copies los deberes todos los días. ¿Qué le dirías?"],["TEST","¿Qué es el pensamiento crítico?",["Criticar todo lo que ves","Analizar la información antes de creerla o actuar","Estar siempre en desacuerdo"],"B"],["REF","¿Alguna vez has tomado una decisión solo por no quedar mal con el grupo? ¿Cómo te sentiste después?"],["DILEMA","Ves una noticia impactante en redes sociales. ¿Qué harías antes de compartirla?"],["VF","Tomarse un tiempo para pensar antes de decidir algo importante es una señal de madurez.","Verdadero"],["ROL","Representa cómo dirías 'no' con seguridad a una propuesta que no te convence, sin sentirte mal por ello."],["TEST","¿Cuál es consecuencia de decidir siempre en caliente (sin pensar)?",["Mejores resultados","Más probabilidad de arrepentirse después","Ninguna diferencia"],"B"],["REF","¿A quién acudes normalmente cuando tienes que tomar una decisión difícil?"],["DILEMA","Te enteras de un plan de 'reto viral' que puede ser peligroso. Tus amigos quieren hacerlo. ¿Qué haces?"],["VF","Pedir opinión a un adulto de confianza en una decisión difícil es un signo de debilidad.","Falso"]]}
  ];
  const colors=["#2787a8","#df5870","#43984f","#eebc00","#e47e1c","#8d4ba8"], tokenColors=["#64c6dc","#ff91a3","#8cda91","#ffe071"];
  const spiral=(()=>{const out=[];let top=0,left=0,bottom=8,right=8;while(top<=bottom&&left<=right){for(let c=left;c<=right;c++)out.push([top,c]);top++;for(let r=top;r<=bottom;r++)out.push([r,right]);right--;if(top<=bottom){for(let c=right;c>=left;c--)out.push([bottom,c]);bottom--}if(left<=right){for(let r=bottom;r>=top;r--)out.push([r,left]);left++}}return out})();
  const $=s=>document.querySelector(s);let playerCount=4,state=null,pending=null;
  function nameInputs(){const box=$("#nameFields");box.innerHTML="";for(let i=0;i<playerCount;i++){const input=document.createElement("input");input.id="name"+(i+1);input.maxLength=18;input.placeholder="Jugador/a "+(i+1);input.setAttribute("aria-label","Nombre del jugador "+(i+1));box.append(input)}}
  nameInputs();$("#playerCount").addEventListener("click",e=>{const b=e.target.closest("button[data-count]");if(!b)return;playerCount=+b.dataset.count;document.querySelectorAll("#playerCount button").forEach(x=>x.classList.toggle("selected",x===b));nameInputs()});
  function newGame(names){state={players:names.map((name,i)=>({name:name||"Jugador/a "+(i+1),color:tokenColors[i],pos:0,wedges:[],turns:0})),turn:0,used:{},pending:null,winner:null};save();showGame()}
  function save(){if(state)LS.set("ensintonia-v1",JSON.stringify(state))}
  function showGame(){ $("#startScreen").classList.remove("active");$("#gameScreen").classList.add("active");$("#resetBtn").classList.remove("hidden");render() }
  function catAt(pos){return cats[pos%cats.length]}
  function render(){if(!state)return;renderLegend();renderBoard();renderPlayers();renderTurn()}
  function renderLegend(){const el=$("#legend");el.innerHTML="";cats.forEach(c=>{const d=document.createElement("span");d.className="legend-item";d.innerHTML='<i class="dot" style="background:'+c.color+'"></i>'+c.name.split(" ")[0];el.append(d)})}
  function renderBoard(){const el=$("#board");el.innerHTML="";const byCell=new Map(spiral.map(([r,c],i)=>[r+":"+c,i]));for(let r=0;r<9;r++)for(let c=0;c<9;c++){const i=byCell.get(r+":"+c),tile=document.createElement("div");if(i===undefined){tile.className="tile empty";tile.setAttribute("aria-hidden","true")}else{const cat=catAt(i);tile.className="tile"+(i===0?" start":"")+(i===spiral.length-1?" finish":"");tile.style.background=cat.color;tile.dataset.pos=i;const label=document.createElement("span");label.className="tile-index";label.textContent=i===0?"SALIDA":i===spiral.length-1?"FINAL":String(i);tile.append(label);if(i===0||i===spiral.length-1){const t=document.createElement("span");t.className="tile-cat";t.textContent=i===0?"SALIDA":"FINAL";tile.append(t)}else{const t=document.createElement("span");t.className="tile-cat";t.textContent=cat.name;tile.append(t)}const here=state.players.filter(p=>p.pos===i);if(here.length){const row=document.createElement("span");row.className="token-row";here.forEach(p=>{const token=document.createElement("span");token.className="token";token.style.background=p.color;token.textContent=p.name.trim().slice(0,1).toUpperCase();token.title=p.name;row.append(token)});tile.append(row)}tile.title=i===0?"Salida":i===spiral.length-1?"Casilla final":cat.name;tile.setAttribute("aria-label",tile.title+" · casilla "+(i+1))}el.append(tile)}}
  function renderPlayers(){const el=$("#players");el.innerHTML="";state.players.forEach((p,i)=>{const row=document.createElement("div");row.className="player"+(i===state.turn&&!state.winner?" active":"");const badge=document.createElement("span");badge.className="badge";badge.style.background=p.color;badge.textContent=p.name.trim().slice(0,1).toUpperCase();const info=document.createElement("span");info.className="p-info";info.innerHTML='<span class="p-name"></span><span class="p-pos"></span>';info.querySelector(".p-name").textContent=p.name;info.querySelector(".p-pos").textContent="Casilla "+(p.pos+1);const wedges=document.createElement("span");wedges.className="wedges";cats.forEach(c=>{const w=document.createElement("i");w.className="wedge"+(p.wedges.includes(c.id)?" earned":"");w.style.background=c.color;w.title=c.name;wedges.append(w)});row.append(badge,info,wedges);el.append(row)})}
  function renderTurn(){const el=$("#turnPanel");if(state.winner){const p=state.players[state.winner];el.innerHTML='<div class="winner"><div class="big-die">✦</div><h2>¡En sintonía!</h2><p><strong></strong> ha conseguido las seis categorías y ha llegado a FINAL.</p><button class="primary" id="againBtn">Jugar otra vez</button></div>';el.querySelector("strong").textContent=p.name;$("#againBtn").onclick=()=>confirmNew();return}const p=state.players[state.turn];if(state.pending){renderCard(el,p,state.pending);return}const goal=p.pos===spiral.length-1;el.innerHTML='<div class="turn-label">Turno de</div><div class="turn-name"><span class="badge" style="background:'+p.color+'">'+escapeHtml(p.name.trim().slice(0,1).toUpperCase())+'</span>'+escapeHtml(p.name)+'</div><p class="turn-instruction">'+(goal?'Estás en FINAL. ¡Un turno más puede darte la victoria!':'Tira el dado y avanzad juntos hasta la categoría que os toque.')+'</p><div class="die-wrap"><div class="die" id="die">–</div><div class="die-text"><strong id="rollTitle">Tirada del dado</strong><span id="rollInfo">El grupo mueve la ficha en equipo.</span></div></div><button class="primary roll" id="rollBtn">Tirar el dado</button><div class="card hidden" id="card"></div>'}
  function renderCard(el,p,draw){const cat=cats.find(c=>c.id===draw.cat),card=draw.card;const typeName={TEST:"TEST",VF:"Verdadero / falso",DILEMA:"Dilema",REF:"Reflexión personal",ROL:"Rol"}[card[0]];el.innerHTML='<div class="turn-label">Turno de</div><div class="turn-name"><span class="badge" style="background:'+p.color+'">'+escapeHtml(p.name.trim().slice(0,1).toUpperCase())+'</span>'+escapeHtml(p.name)+'</div><div class="die-wrap"><div class="die">'+draw.roll+'</div><div class="die-text"><strong>Habéis sacado un '+draw.roll+'</strong><span>Casilla '+(p.pos+1)+' · '+cat.name+'</span></div></div><article class="card" style="border-left-color:'+cat.color+'"><div class="card-head"><span class="category-tag">'+cat.name+'</span><span class="type-tag">'+typeName+'</span></div><p class="question"></p><div class="answers"></div><div class="feedback" aria-live="polite"></div></article>';const article=el.querySelector(".card");article.querySelector(".question").textContent=card[1];const answers=article.querySelector(".answers"),feedback=article.querySelector(".feedback");if(card[0]==="TEST"||card[0]==="VF"){const opts=card[0]==="VF"?["Verdadero","Falso"]:card[2].map((x,i)=>String.fromCharCode(65+i)+") "+x);opts.forEach((txt,i)=>{const b=document.createElement("button");b.type="button";b.className="answer";b.textContent=txt;b.onclick=()=>grade(b,i,draw,feedback);answers.append(b)})}else{const note=document.createElement("p");note.className="subjective";note.textContent=card[0]==="ROL"?"Representad la situación entre todos.":card[0]==="DILEMA"?"No hay una única respuesta correcta: escuchad los argumentos.":"No se evalúa la respuesta: compartidla solo hasta donde os sintáis cómodos.";answers.append(note);const done=document.createElement("button");done.className="primary complete";done.textContent="Hemos participado";done.onclick=()=>finishTurn(true,draw,feedback);answers.append(done)}}
  function grade(btn,index,draw,feedback){if(state.pending!==draw)return;const card=draw.card,answer=card[0]==="VF"?card[2]:("ABC"[index]);const correct=card[0]==="VF"?btn.textContent===answer:answer===card[3];document.querySelectorAll(".answer").forEach(b=>{b.disabled=true});btn.classList.add(correct?"correct":"wrong");if(!correct){const correctText=card[0]==="VF"?answer:(answer+") "+card[2]["ABC".indexOf(answer)]);feedback.className="feedback bad";feedback.textContent="No exactamente. La respuesta era: "+correctText+"."}else{feedback.className="feedback good";feedback.textContent="¡Correcto!"}const next=document.createElement("button");next.className="primary complete";next.style.marginTop="10px";next.textContent="Continuar";next.onclick=()=>finishTurn(correct,draw,feedback);feedback.after(next)}
  function finishTurn(earned,draw,feedback){const p=state.players[state.turn],cat=cats.find(c=>c.id===draw.cat);if(earned&&!p.wedges.includes(cat.id))p.wedges.push(cat.id);p.turns++;if(p.pos===spiral.length-1&&p.wedges.length===cats.length){state.winner=state.turn}else if(p.pos===spiral.length-1){p.pos=0;state.pending=null;state.turn=(state.turn+1)%state.players.length;save();render();return}else{state.pending=null;state.turn=(state.turn+1)%state.players.length}save();render()}
  function roll(){const p=state.players[state.turn],n=1+Math.floor(Math.random()*6),next=Math.min(spiral.length-1,p.pos+n);p.pos=next;if(next===spiral.length-1&&p.wedges.length===cats.length){state.winner=state.turn;state.pending=null;save();render();return}const cat=catAt(next);const deck=cat.cards.map((_,i)=>i),key=cat.id,used=state.used[key]||[];let available=deck.filter(i=>!used.includes(i));if(!available.length){available=deck;state.used[key]=[]}const idx=available[Math.floor(Math.random()*available.length)];state.used[key]=(state.used[key]||[]).concat(idx);state.pending={cat:key,card:cat.cards[idx],roll:n};save();render() }
  $("#startBtn").onclick=()=>{const names=Array.from({length:playerCount},(_,i)=>$("#name"+(i+1)).value.trim());newGame(names)};
  $("#resetBtn").onclick=confirmNew;
  function confirmNew(){if(confirm("¿Empezar una partida nueva? Se borrará el progreso guardado en este Chromebook.")){LS.del("ensintonia-v1");state=null;pending=null;$("#gameScreen").classList.remove("active");$("#startScreen").classList.add("active");$("#resetBtn").classList.add("hidden")}}
  document.addEventListener("click",e=>{if(e.target.id==="rollBtn")roll();if(e.target.id==="rulesBtn")showRules();if(e.target.id==="modalClose"||e.target.id==="modal")$("#modal").classList.remove("open")});
  function showRules(){ $("#modalText").innerHTML='<p>En vuestro turno, tirad el dado, avanzad por la espiral y leed la tarjeta de la categoría correspondiente.</p><p>En los TEST y verdadero/falso, elegid una respuesta. En los dilemas, reflexiones y roles, participad y pulsad <strong>Hemos participado</strong>. Cada categoría solo da un quesito por jugador.</p><p>Gana quien reúna los seis quesitos y llegue a FINAL. Si alguien llega a FINAL antes de tenerlos, vuelve a SALIDA y continúa jugando.</p>';$("#modal").classList.add("open") }
  function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
  const saved=LS.get("ensintonia-v1");if(saved){try{state=JSON.parse(saved);if(state&&state.players?.length&&state.players.every(p=>Array.isArray(p.wedges))){showGame()}else LS.del("ensintonia-v1")}catch{LS.del("ensintonia-v1")}}
  </script>
